digraph CFG {
    graph [rankdir=TB, splines=ortho, nodesep=1.0, ranksep=1.2, bgcolor=white, fontname="Arial"];
    node  [shape=ellipse, style=filled, fillcolor=white, color=black, fontname="Arial", fontsize=11, penwidth=1.5, margin="0.4,0.2"];
    edge  [color=black, arrowsize=0.9, penwidth=1.3, fontname="Arial", fontsize=10];

    N0 [label="START", fillcolor="#c8c8c8", fontsize=13, fontweight=bold, width=1.6, height=0.7];
    N1 [label="FUNCTION foo", fillcolor="#f0f0f0", fontsize=11, fontweight=bold];
    N2 [label="RETURN (x + 1)"];
    N3 [label="END foo", fillcolor="#c8c8c8", fontsize=13, fontweight=bold, width=1.6, height=0.7];
    N4 [label="FUNCTION main", fillcolor="#f0f0f0", fontsize=11, fontweight=bold];
    N5 [label="a = 5\nb = (a + 2)"];
    N6 [label="IF ((b > 5))", fillcolor="#ffffff"];
    N7 [label="b = foo(b)"];
    N8 [label="b = (b - 1)"];
    N9 [label="MERGE", fillcolor="#eeeeee"];
    N10 [label="FOR INIT: i = 0", fillcolor="#ffffff"];
    N11 [label="FOR COND: ((i < 3))", fillcolor="#ffffff"];
    N12 [label="FOR EXIT", fillcolor="#ffffff"];
    N13 [label="b = (b + i)"];
    N14 [label="FOR NEXT: p++i", fillcolor="#ffffff"];
    N15 [label="WHILE ((a < 10))", fillcolor="#ffffff"];
    N16 [label="LOOP EXIT", fillcolor="#ffffff"];
    N17 [label="a = (a + 1)"];
    N18 [label="IF ((a == 7))", fillcolor="#ffffff"];
    N19 [label="CONTINUE", fillcolor="#eeeeee"];
    N20 [label="MERGE", fillcolor="#eeeeee"];
    N21 [label="IF ((a == 9))", fillcolor="#ffffff"];
    N22 [label="BREAK", fillcolor="#eeeeee"];
    N23 [label="MERGE", fillcolor="#eeeeee"];
    N24 [label="b = (b + a)"];
    N25 [label="RETURN b"];
    N26 [label="END main", fillcolor="#c8c8c8", fontsize=13, fontweight=bold, width=1.6, height=0.7];

    N0 -> N1;
    N0 -> N4;
    N1 -> N2;
    N2 -> N3;
    N4 -> N5;
    N5 -> N6;
    N6 -> N7 [label=" True "];
    N6 -> N8 [label=" False "];
    N7 -> N9;
    N8 -> N9;
    N9 -> N10;
    N10 -> N11;
    N11 -> N13 [label=" True "];
    N11 -> N12 [label=" False "];
    N12 -> N15;
    N13 -> N14;
    N14 -> N11;
    N15 -> N17 [label=" True "];
    N15 -> N16 [label=" False "];
    N16 -> N25;
    N17 -> N18;
    N18 -> N19 [label=" True "];
    N18 -> N20 [label=" False "];
    N19 -> N15;
    N19 -> N20;
    N20 -> N21;
    N21 -> N22 [label=" True "];
    N21 -> N23 [label=" False "];
    N22 -> N16;
    N22 -> N23;
    N23 -> N24;
    N24 -> N15;
    N25 -> N26;
}